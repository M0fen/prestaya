# ─────────────────────────────────────────────────────────────────────────
#  Presta Ya — variables de entorno (EJEMPLO, sin valores reales)
#
#  Copia este archivo a `.env.local` y pega allí tus claves de Supabase.
#  `.env.local` está en .gitignore y NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase. Pública (va al navegador).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública). Respeta Row Level Security. Va al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: PODER TOTAL, ignora RLS.
# ⚠️ SOLO en el servidor (server components / route handlers). NUNCA en el
#    navegador y NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Clave para CIFRAR el chat interno en reposo (AES-256-GCM). 32 bytes en base64.
# Generá una con:  openssl rand -base64 32
# ⚠️ SOLO servidor (sin NEXT_PUBLIC_). Si se pierde, los mensajes viejos quedan
#    ilegibles. Si falta, el chat funciona pero SIN cifrar (aviso en consola).
CHAT_SECRET_KEY=

# Clave del asesor IA (DeepSeek). Solo servidor (sin NEXT_PUBLIC_).
# Si falta, el panel funciona pero el asesor flotante queda deshabilitado.
DEEPSEEK_API_KEY=

# ── Avisos PUSH internos (admin/supervisor/cobrador) ──────────────────────
# Generá estas 4 con:  node scripts/gen-vapid.mjs
# Si faltan, la app funciona igual pero NO ofrece "Activar avisos" ni manda push.
# La pública SÍ lleva NEXT_PUBLIC_ (es la applicationServerKey, va al navegador).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# La privada firma los envíos. SOLO servidor (sin NEXT_PUBLIC_).
VAPID_PRIVATE_KEY=
# A quién "pertenece" el push (mailto o URL). Solo servidor.
VAPID_SUBJECT=mailto:admin@prestaya.uy
# Secreto para proteger el cron del "cierre del día" (/api/cron/cierre-dia).
CRON_SECRET=
